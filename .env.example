# webrecon configuration template.
#
# Copy this file to `.env` (in the project root or anywhere in your
# CWD) and fill in the credentials you have. Every variable is
# optional; modules whose credential is missing fail fast with a
# descriptive error rather than silently skipping.
#
# Full reference: docs/webrecon/configuration.md

# Logging.
WEBRECON_LOG_LEVEL=INFO

# FOFA (https://en.fofa.info/api).
# WEBRECON_API_KEYS__FOFA__EMAIL=you@example.com
# WEBRECON_API_KEYS__FOFA__KEY=your-fofa-key

# Shodan (https://developer.shodan.io).
# WEBRECON_API_KEYS__SHODAN=your-shodan-key

# Serper.dev (https://serper.dev).
# WEBRECON_API_KEYS__SERPER=your-serper-key

# GitHub PAT.
# Accepts ghp_..., gho_..., ghs_..., ghu_..., ghr_..., github_pat_...,
# or a 40-character hex legacy token.
# WEBRECON_API_KEYS__GITHUB=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe secret/restricted key for live-key validation.
# Accepts sk_live_..., sk_test_..., rk_live_..., rk_test_....
# WEBRECON_API_KEYS__STRIPE=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Concurrency knobs (defaults shown).
# WEBRECON_CONCURRENCY__MAX_CONNECTIONS=20
# WEBRECON_CONCURRENCY__PER_HOST_LIMIT=5
# WEBRECON_CONCURRENCY__SEMAPHORE_SIZE=15

# Rate limit (defaults shown).
# WEBRECON_RATE_LIMITING__REQUESTS_PER_SECOND=10.0
# WEBRECON_RATE_LIMITING__RESPECT_ROBOTS_TXT=true

# Database (defaults shown).
# WEBRECON_DATABASE__PATH=webrecon.sqlite3

# Safety guards (defaults shown). At least one of TEST_MODE and
# REQUIRE_CONFIRMATION must remain `true`; setting both to `false`
# is rejected by the configuration validator.
# WEBRECON_SAFETY__TEST_MODE=true
# WEBRECON_SAFETY__USE_TEST_DATA_ONLY=true
# WEBRECON_SAFETY__REQUIRE_CONFIRMATION=true
